{% extends 'base.html.twig' %}

{% block title %}Créer un nouvel article{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">

        <h1 class="mb-4">📝 Créer un nouvel article</h1>

        {{ form_start(formulaire) }}

            <div class="mb-3">
                {{ form_row(formulaire.titre) }}
            </div>

            <div class="mb-3">
                {{ form_row(formulaire.contenu) }}
            </div>

            <div class="mb-3">
                {{ form_row(formulaire.categorie) }}
            </div>

            <div class="mb-3">
                {{ form_row(formulaire.auteur) }}
            </div>

            <div class="mb-3">
                {{ form_row(formulaire.publie) }}
            </div>

            {# ✅ BOUTON EN DERNIER #}
            <div class="mt-4">
                {{ form_row(formulaire.enregistrer) }}
            </div>

        {{ form_end(formulaire) }}

    </div>
</div>
{% endblock %}