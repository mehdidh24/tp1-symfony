{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">✏️ Modifier la catégorie</h1>
            <p class="text-muted mb-4 pb-2 border-bottom">
                Modification de « {{ categorie.nom }} »
            </p>

            {{ form_start(formulaire) }}
                <div class="mb-3">
                    {{ form_row(formulaire.nom) }}
                </div>

                {# si tu as une description #}
                {% if formulaire.description is defined %}
                    <div class="mb-3">
                        {{ form_row(formulaire.description) }}
                    </div>
                {% endif %}

                {{ form_row(formulaire.enregistrer) }}
            {{ form_end(formulaire) }}

            <a href="{{ path('app_categories') }}" class="btn btn-link mt-3 text-muted">
                ← Annuler
            </a>
        </div>
    </div>
{% endblock %}